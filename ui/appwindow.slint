import { Button, VerticalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    in-out property <string> password: "";
    in-out property <bool> use-uppercase: true;
    in-out property <bool> use-numbers: true;
    in-out property <bool> use-symbols: true;
    in-out property <int> length: 16;

    callback generate-password();

    title: "Password Generator";
    min-width: 400px;
    min-height: 300px;

    VerticalBox {
        alignment: start;
        spacing: 10px;
        padding: 20px;

        Text {
            text: "Generated Password:";
            font-size: 14px;
        }

        LineEdit {
            text: root.password;
            read-only: true;
            font-size: 18px;
            horizontal-alignment: center;
        }

        VerticalBox {
            spacing: 5px;
            CheckBox {
                text: "Include Uppercase Letters";
                checked: root.use-uppercase;
                toggled => { root.use-uppercase = !root.use-uppercase; }
            }
            CheckBox {
                text: "Include Numbers";
                checked: root.use-numbers;
                toggled => { root.use-numbers = !root.use-numbers; }
            }
            CheckBox {
                text: "Include Symbols";
                checked: root.use-symbols;
                toggled => { root.use-symbols = !root.use-symbols; }
            }
        }

        Button {
            text: "Generate";
            primary: true;
            clicked => { root.generate-password(); }
        }
    }
}
